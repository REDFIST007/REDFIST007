# Application Security (Rotate APP_SECRET_KEY in production; never commit .env)
APP_SECRET_KEY=change-me-in-production-use-32-byte-random-hex
SESSION_TTL_MINUTES=480
INVITE_TTL_HOURS=48

# Database (SQLite by default; swap for Postgres DSN in production)
DATABASE_PATH=./school_ops.db
UPLOAD_DIR=./uploads

# Optional LLM Provider (System works deterministically offline if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=deterministic

# Chat Channels (Optional for live webhooks; built-in simulator works out of the box)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=

# CORS & Rate Limiting
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=120
